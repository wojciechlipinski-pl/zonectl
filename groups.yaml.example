# Plik: /etc/elkman-dns-toolkit/groups.yaml
# Domeny nieujęte poniżej trafią automatycznie do grupy "Pozostałe".
groups:
  Urząd Miasta:
    - city.example.pl
    - portal.example.pl
    - digital.example.pl
    - council.example.pl
  Jednostki:
    - services.example.pl
    - transit.example.pl
    - nursery.example.pl
    - care.example.pl
  Prywatne:
    - example.pl
    - private-a.example.pl
    - private-b.example.pl
